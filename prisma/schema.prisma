// Esquema de la base de datos del proyecto Bionexo.
// Motor: SQLite en local (se migra a Postgres al desplegar).
// Documentación completa en CLAUDE.md y en Documentacion/MANUAL_APRENDIZAJE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Categorías del catálogo (10 en total: las 8 originales + Servicios + Otros productos).
model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEs        String
  nameEn        String
  descriptionEs String
  descriptionEn String
  products      Product[]
}

// Datos internos del productor o emprendedor que ofrece el producto.
// NUNCA se muestran al cliente: son solo para uso interno del negocio
// (reportes, cobro del margen de intermediación y contacto directo con el proveedor).
// Se gestionarán desde el panel de administración en la Fase 3.
model Producer {
  id          String    @id @default(cuid())
  name        String    // Nombre del emprendimiento o razón social
  contactName String    // Nombre de la persona de contacto
  phone       String    // Teléfono del productor (SOLO uso interno)
  email       String?   // Correo del productor (opcional, SOLO uso interno)
  notes       String?   // Notas internas sobre el productor
  products    Product[]
}

// Producto del catálogo.
// Regla de oro del modelo de intermediación: los campos del productor y el margen
// NUNCA se exponen en APIs públicas ni en páginas visibles al cliente.
model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameEs        String
  nameEn        String
  descriptionEs String
  descriptionEn String
  priceCop      Int
  available     Boolean  @default(true)
  featured      Boolean  @default(false)
  imageUrl      String

  // --- Origen del producto ---
  originCity       String  @default("Bucaramanga")  // Ciudad de origen (Colombia)
  originDepartment String  @default("Santander")    // Departamento de origen (Colombia)
  isInternational  Boolean @default(false)           // true → el producto viene de fuera de Colombia
  originCountry    String?                           // País de origen (solo si isInternational = true)

  // --- Características visibles al cliente ---
  size             String? // Tamaño o medida del producto (p.ej. "25 kg", "2×1 m")
  warranty         Boolean @default(false) // ¿El producto tiene garantía?
  warrantyDuration String?                 // Duración de la garantía (p.ej. "6 meses", "1 año")

  // --- Intermediación: SOLO para uso interno, NUNCA exponer al cliente ---
  margin Float @default(5.0) // Porcentaje de margen de Bionexo sobre el precio (3–10 %)

  // --- Zona de venta: A DÓNDE se vende/envía el producto (distinto del origen,
  // que es DE DÓNDE es). "nacional" = todo el país; "internacional" = todo el
  // país + exterior; "local" = solo los municipios listados en saleMunicipalities. ---
  saleZone         String                   @default("nacional")
  saleMunicipalities ProductSaleMunicipality[]

  // --- Relaciones ---
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  variants   Variant[]

  producerId String?   // Productor que fabrica u ofrece este producto (puede ser null)
  producer   Producer? @relation(fields: [producerId], references: [id])
}

// Municipio donde se vende un producto con zona de venta "local".
// Solo tiene filas cuando Product.saleZone = "local"; un producto puede tener
// varios (municipios de distintos departamentos incluso).
model ProductSaleMunicipality {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  department   String
  municipality String
}

// Variante de un producto (talla, color o material).
model Variant {
  id        String  @id @default(cuid())
  type      String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Caché de la tasa de cambio COP→USD. Solo existe una fila (patrón singleton).
// Se reutiliza hasta 6 horas antes de consultarle a la API externa.
model ExchangeRate {
  id        String   @id @default("singleton")
  usdPerCop Float
  updatedAt DateTime @updatedAt
}

// Pedido registrado por un comprador.
model Order {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  status          String      @default("pendiente")
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  destCity        String
  destAddress     String
  isInternational Boolean     @default(false)
  shippingCop     Int
  shippingDetail  String      // JSON: [{zonaOrigen, costo}]
  subtotalCop     Int
  totalCop        Int
  items           OrderItem[]
}

// Ítem de un pedido: copia los datos del producto en el momento de la compra
// para que el historial sea consistente aunque el producto se edite o elimine.
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  productNameEs String
  productNameEn String
  originCity    String
  variantLabel  String?
  unitPriceCop  Int
  quantity      Int     @default(1)
}

// Publicación de la sección "Noticias y Historias": noticias/artículos cortos
// sobre economía circular y medio ambiente, e historias motivacionales de la
// marca y de los productores. Se gestiona por completo desde el panel.
model Post {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEs       String
  titleEn       String
  summaryEs     String   // resumen corto para el listado
  summaryEn     String
  contentEs     String   // texto completo (párrafos simples, sin editor enriquecido)
  contentEn     String
  coverImageUrl String   // foto de portada, subida desde el panel

  // Video incrustado (opcional): SOLO se guarda el enlace que pega el admin,
  // nunca se sube un archivo de video al servidor. Se valida y se convierte
  // en un iframe embebido con src/lib/video-embed.ts.
  videoUrl String?

  publishedAt DateTime @default(now()) // fecha de publicación, editable a mano
  status      String   @default("borrador") // "publicado" | "borrador"
}
